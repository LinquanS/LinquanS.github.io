---
import CategoryNav from "../components/CategoryNav.astro";
import "../styles/portfolio.css";
const title = "Linquan Sun | Photography";
const description = "A personal photography portfolio by Linquan Sun.";
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f7f3" />
    <link rel="icon" type="image/svg+xml" href="/images/camera-favicon.svg" />
    <link rel="canonical" href="https://linquans.github.io/" />
    <title>{title}</title>
  </head>
  <body>
    <main class="portfolio">
      <header class="site-header">
        <a class="site-wordmark" href="/">Linquan Sun</a>
        <CategoryNav />
      </header>
      <section class="portfolio-intro home-intro">
        <div class="home-copy">
          <h1>Photography<span class="heading-period">.</span></h1>
          <p class="intro-copy">“It is putting one's head, one's eye, and one's heart on the same axis.”</p>
        </div>
      </section>
    </main>
  </body>
</html>
