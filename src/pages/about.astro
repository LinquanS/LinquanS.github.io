---
import "../styles/portfolio.css";
const title = "About | Linquan Sun";
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="A little about Linquan Sun." /><title>{title}</title>
    <link rel="icon" type="image/png" href="/images/favicon.png" />
  </head>
  <body>
    <main class="portfolio about-page">
      <a class="text-link back-link" href="/">← Back to the photographs</a>
      <section class="portfolio-intro">
        <p class="eyebrow">A little about me</p><h1>Linquan Sun<span>.</span></h1>
        <div class="intro-copy about-copy">
          <p>I grew up in China and now live in the UK, where I work in fintech. Photography is how I slow down and pay attention—to city streets, people, changing light, and the small details of everyday life. I work across digital and film, following whatever feels right for the moment.</p>
        </div>
        <img class="about-profile-photo" src="/images/profile.jpg" alt="Linquan Sun photographing outdoors" width="1200" height="1200" loading="lazy" decoding="async" />
      </section>
    </main>
  </body>
</html>
