---
import "../styles/portfolio.css";
const title = "Page not found | Linquan Sun";
---
<!doctype html>
<html lang="en-GB">
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>{title}</title><link rel="icon" type="image/svg+xml" href="/images/camera-favicon.svg" /></head>
  <body>
    <main class="portfolio not-found-page">
      <header class="site-header">
        <a class="site-wordmark" href="/">Linquan Sun</a>
        <span class="header-note">FIELD NOTES&nbsp; / &nbsp;LONDON</span>
      </header>
      <section class="portfolio-intro not-found-intro">
        <p class="eyebrow">Erratum <span class="eyebrow-divider"> / </span> 404</p>
        <h1>Not found<span class="heading-period">.</span></h1>
        <p class="intro-copy">This page is outside the frame.</p>
        <a class="text-link" href="/">Return to the photographs <span aria-hidden="true">↗</span></a>
      </section>
    </main>
  </body>
</html>
