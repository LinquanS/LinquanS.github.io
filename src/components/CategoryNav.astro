---
import { photoGroups } from "../data/photo-groups.js";
const { currentCategory, currentPage } = Astro.props;
---
<nav class="site-nav" aria-label="Main navigation">
  {photoGroups.map((group) => (
    <a
      class="category-nav-link"
      href={`/${group.id}/`}
      aria-label={group.label}
      title={group.label}
      aria-current={group.id === currentCategory ? "page" : undefined}
    >
      <svg class="category-icon" viewBox="0 0 24 24" aria-hidden="true">
        {group.id === "animal" && (
          <>
            <path d="M3.2 15.3c1.5-3.1 4.6-4.7 8.1-4.4.5-2.5 2.3-4.2 4.5-4 2 .2 3.1 1.9 2.9 3.7l3.1 1.1-3.4 1.2c-2.4 3.5-7.7 4.7-13.1 2.4Z" />
            <path d="M8.4 13.9c2.1-1.1 4.5-1.3 6.7-.7M5.2 15.4 2.8 18l5.1-.9m2.4.2-.2 1.5m4.2-1.8.3 1.6" />
            <circle cx="16.1" cy="8.8" r=".5" fill="currentColor" stroke="none" />
          </>
        )}
        {group.id === "people" && (
          <>
            <circle cx="12" cy="7.2" r="3.4" />
            <path d="M5.2 20c.3-4.2 2.8-6.7 6.8-6.7s6.5 2.5 6.8 6.7H5.2Z" />
          </>
        )}
        {group.id === "places" && (
          <>
            <circle cx="17.5" cy="6.3" r="2.1" />
            <path d="m2.5 18 6.6-8 4.1 4.3 2.4-2.4 6 6.1H2.5Z" />
            <path d="M2.5 20.5h19" />
          </>
        )}
        {group.id === "still" && (
          <>
            <path d="M4 19h16M6.2 17.5l1.1-6h9.4l1.1 6M12 11.5V7.7" />
            <path d="M12 8c-2.3-1-2.8-3.3-1-4.6 2.5.2 3.4 2.5 1 4.6Zm.3.1c.2-2.5 2.3-3.7 4.1-2.6.5 2.4-1.2 4.1-4.1 2.6Z" />
          </>
        )}
      </svg>
    </a>
  ))}
  <a href="/about/" aria-current={currentPage === "about" ? "page" : undefined}>About</a>
</nav>
